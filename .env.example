# Optional cloud AI configuration.
# CineFlow's core editor and Quick Edit Assistant work without API keys.
# Add a Gemini key only if you want server-side speech transcription,
# caption translation, and script-to-timeline generation.
GEMINI_API_KEY=

# Optional Claude integration for server-side AI endpoints.
# The built-in Quick Edit Assistant does not use Claude.
ANTHROPIC_API_KEY=

# Optional application URL used by server integrations.
APP_URL="http://localhost:3000"
